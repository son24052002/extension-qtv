{
  "manifest_version": 3,
  "name": "QTV YouTube Player Bridge",
  "version": "3.0",
  "description": "Điều khiển trực tiếp Tab YouTube gốc từ QTV — siêu mượt, 1080p/4K, mở khóa 100% video bản quyền",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://qtv-omega.vercel.app/*",
    "http://localhost/*",
    "http://192.168.1.160/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://qtv-omega.vercel.app/*",
        "http://localhost/*",
        "http://192.168.1.160/*"
      ],
      "js": ["qtv-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["youtube-player.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["youtube-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
